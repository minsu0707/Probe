{
  "name": "probe",
  "version": "0.2.70",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch server/main.ts",
    "web": "vite",
    "build": "vite build",
    "start": "node server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "smoke": "node scripts/smoke.ts",
    "launch": "node scripts/launch.ts",
    "stop": "node scripts/stop.ts",
    "autostart:on": "node scripts/windows.ts autostart on",
    "autostart:off": "node scripts/windows.ts autostart off",
    "shortcut": "node scripts/windows.ts shortcut",
    "desktop": "electron .",
    "pack": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win --publish never",
    "release": "node scripts/release.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.64.1",
    "dotenv": "^18.0.9",
    "electron-updater": "^6.8.11",
    "fflate": "^0.8.3",
    "hono": "^4.13.14",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "allowScripts": {
    "electron@45.0.0": true
  },
  "productName": "Probe",
  "description": "Test automation dashboard for Claude and Playwright",
  "author": "minsu0707",
  "main": "desktop/main.ts",
  "build": {
    "appId": "com.minsu0707.probe",
    "productName": "Probe",
    "artifactName": "Probe-Setup-${version}.exe",
    "asar": false,
    "afterPack": "scripts/after-pack.cjs",
    "electronLanguages": [
      "en-US",
      "ko"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "server/**/*",
      "shared/**/*",
      "reporter/**/*",
      "mcp/**/*",
      "scripts/**/*",
      "dist/**/*",
      "package.json",
      "!**/*.map",
      "!**/node_modules/**/*.{md,d.ts,d.mts,d.cts,markdown}",
      "!**/node_modules/**/{tests,docs,example,examples,.github}/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Probe",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "minsu0707",
        "repo": "Probe",
        "releaseType": "draft"
      }
    ]
  }
}
